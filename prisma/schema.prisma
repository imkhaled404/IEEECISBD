// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}


model CommitteeMember {
  id           String @id @default(cuid())
  name         String
  role         String
  year         String
  category     String // e.g., EXCOM, SAC, SPARK
  imageUrl     String?
  university   String?
  email        String?
  linkedinUrl  String?
  bio          String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())
}

model Event {
  id               String   @id @default(cuid())
  title            String
  description      String?
  date             DateTime
  venue            String?
  imageUrl         String?
  registrationLink String?
  type             String   // upcoming, previous
  createdAt        DateTime @default(now())
}

model Chapter {
  id          String   @id @default(cuid())
  name        String
  chair       String?
  advisor     String?
  emails      String?  // comma separated or JSON
  websiteUrl  String?
  imageUrl    String?
  createdAt   DateTime @default(now())
}

model Achievement {
  id        String   @id @default(cuid())
  title     String
  year      String
  category  String
  winner    String
  imageUrl  String?
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  createdAt DateTime @default(now())
}

model GalleryImage {
  id        String   @id @default(cuid())
  title     String?
  imageUrl  String
  caption   String?
  createdAt DateTime @default(now())
}

model BlogPost {
  id        String   @id @default(cuid())
  title     String
  author    String
  date      DateTime @default(now())
  excerpt   String
  content   String   // Markdown or HTML
  imageUrl  String?
  createdAt DateTime @default(now())
}

model HeroSlider {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  imageUrl    String
  link        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?
  role          String    @default("ADMIN")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
